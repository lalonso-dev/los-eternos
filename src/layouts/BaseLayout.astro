---
import "../styles/global.css";
import { socialLinks } from "../data/socialLinks";
import { contacts } from "../data/contacts";
import { integrantes, nombreCorto } from "../data/integrantes";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Los Eternos | Grupo Norteño en Morelia, Michoacán",
  description = "Los Eternos, grupo norteño de Morelia, Michoacán. Música en vivo con acordeón, bajo quinto, bajo eléctrico y batería para bodas, XV años y fiestas.",
  noindex = false,
} = Astro.props;

// Imagen para compartir (1200x630): generada con `npm run og`. El ?v= fuerza a
// WhatsApp/Facebook a descartar la imagen anterior que tengan en caché.
const OG_VERSION = 2;
const ogImageUrl = new URL(`/og-image.jpg?v=${OG_VERSION}`, Astro.site);
const ogImageAlt = "Los Eternos, grupo norteño de Morelia, Michoacán: cinco músicos con sombrero y chamarra de piel";
const siteUrl = new URL("/", Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// Datos estructurados para Google (solo en páginas públicas).
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  "@id": `${siteUrl}#grupo`,
  name: "Los Eternos",
  alternateName: "Los Eternos Grupo Norteño",
  url: siteUrl,
  description,
  image: ogImageUrl.href,
  logo: new URL("/favicon/web-app-manifest-512x512.png", Astro.site).href,
  genre: ["Música norteña", "Grupo norteño", "Música regional mexicana"],
  foundingLocation: { "@type": "Place", name: "Morelia, Michoacán, México" },
  areaServed: { "@type": "AdministrativeArea", name: "Michoacán, México" },
  sameAs: socialLinks.map((s) => s.href),
  member: integrantes.map((m) => ({
    "@type": "Person",
    name: nombreCorto(m),
    jobTitle: m.rol,
  })),
  contactPoint: contacts.map((c) => ({
    "@type": "ContactPoint",
    contactType: "contrataciones",
    name: c.name,
    telephone: `+${c.phone}`,
    availableLanguage: "es",
  })),
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Los Eternos" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Los Eternos" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class="bg-negro text-cream font-body overflow-x-hidden">
    <slot />
  </body>
</html>
