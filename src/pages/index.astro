---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Bio from "../components/Bio.astro";
import Music from "../components/Music.astro";
import Gallery from "../components/Gallery.astro";
import Eventos from "../components/Eventos.astro";
import Redes from "../components/Redes.astro";
import Contrataciones from "../components/Contrataciones.astro";
import Footer from "../components/Footer.astro";
import FloatingSocialRail from "../components/FloatingSocialRail.astro";
---

<BaseLayout>
  <Nav />
  <FloatingSocialRail />
  <main>
    <Hero />
    <Bio />
    <Music />
    <Gallery />
    <Eventos />
    <Redes />
    <Contrataciones />
  </main>
  <Footer />
</BaseLayout>
