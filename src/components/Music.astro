---
import Icon from "./Icon.astro";
import SectionHeader from "./SectionHeader.astro";
import SpotifyEmbed from "./SpotifyEmbed.astro";
import { musicPlatforms } from "../data/musicPlatforms";

const spotify = musicPlatforms.find((p) => p.icon === "spotify");
---

<section id="musica" class="band scroll-mt-24 px-6 py-24 text-center md:px-20 md:py-36">
  <SectionHeader
    eyebrow="Escucha"
    title="Nuestra Música"
    subtitle="Encuentra nuestras canciones en tus plataformas favoritas"
  />
  {spotify && (
    <div class="mb-14">
      <SpotifyEmbed url={spotify.href} />
    </div>
  )}

  <div class="mx-auto flex max-w-4xl flex-wrap justify-center gap-6">
    {musicPlatforms.map((platform) => (
      <a
        href={platform.href}
        target="_blank"
        rel="noreferrer"
        class="card flex w-full max-w-[260px] flex-1 flex-col items-center gap-4 px-6 py-10"
        style={`--brand: ${platform.color}`}
      >
        <span class="icon-ring h-14 w-14">
          <Icon name={platform.icon} class="h-6 w-6" />
        </span>
        <span class="text-sm font-bold uppercase tracking-[0.14em] text-cream">{platform.name}</span>
      </a>
    ))}
  </div>
</section>
