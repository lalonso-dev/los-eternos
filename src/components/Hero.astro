---
import { Image } from "astro:assets";
import portada from "../assets/banner-sin-logo.jpeg";
import wordmark from "../assets/eternos-logo-sin-fondo.png";
---

<section id="top" class="relative overflow-hidden bg-negro text-center">
  <!-- Ambiente: la misma foto, desenfocada, para que el humo siga hacia los lados -->
  <Image
    src={portada}
    alt=""
    width={400}
    aria-hidden="true"
    class="absolute inset-0 h-full w-full scale-125 object-cover opacity-30 blur-2xl"
  />

  <!-- Video: empieza oculto; entra con un fundido cuando ya está reproduciéndose -->
  <div class="hero-video absolute inset-0" aria-hidden="true">
    <video
      muted
      loop
      playsinline
      preload="none"
      class="absolute left-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 object-cover"
    >
      <source data-src="/assets/video/bk-video-web.mp4" type="video/mp4" />
    </video>
    <!-- Velo grafito: apaga el color del video (camiseta rosa, rótulos) y da lectura al texto -->
    <div class="absolute inset-0 bg-negro/35"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-negro/70 via-transparent to-negro"></div>
    <div
      class="absolute inset-0"
      style="background: radial-gradient(70% 55% at 50% 60%, rgb(11 11 12 / 0.55), transparent 80%);"
    >
    </div>
  </div>

  <!-- Foto + contenido comparten contenedor para que el solape sea proporcional -->
  <div class="relative mx-auto w-full max-w-[min(100vw,92svh)] pt-20 md:max-w-[min(100vw,90svh)] md:pt-0">
    <div class="hero-photo relative aspect-square w-full overflow-hidden md:aspect-[5/4]">
      <Image
        src={portada}
        alt="Los Eternos, grupo norteño de Morelia, Michoacán"
        width={1600}
        loading="eager"
        fetchpriority="high"
        class="hero-kenburns h-full w-full object-cover object-top"
      />
    </div>

    <!-- Contenido: se monta sobre el humo, donde la portada original lleva el logo -->
    <div
      class="hero-content relative z-10 mx-auto -mt-[40%] flex w-full max-w-2xl flex-col items-center px-6 pb-24 md:-mt-[30%]"
    >
      <h1 class="w-[min(74vw,340px)] drop-shadow-[0_8px_28px_rgb(0_0_0/0.8)] md:w-[340px]">
        <Image
          src={wordmark}
          alt="Los Eternos"
          width={800}
          class="w-full object-contain"
        />
      </h1>
      <div class="eyebrow mt-4 mb-0 !gap-3 whitespace-nowrap !text-[11px] !tracking-[0.22em] sm:!text-xs sm:!tracking-[0.32em]">
        <span class="hidden h-px w-10 bg-gradient-to-r from-transparent to-dorado sm:block"></span>
        De Morelia, Michoacán
        <span class="hidden h-px w-10 bg-gradient-to-l from-transparent to-dorado sm:block"></span>
      </div>
      <p class="mx-auto mt-4 mb-6 max-w-md text-[15px] leading-relaxed text-cream/85 md:text-base">
        Música auténtica, directo del corazón. Llevamos el sonido de nuestra
        tierra a cada escenario.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="#musica" class="btn-gold">Escuchar Música</a>
        <a href="#contrataciones" class="btn-ghost">Contratar</a>
      </div>
    </div>
  </div>

  <!-- Fundido final hacia la siguiente sección -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-negro to-transparent"></div>
</section>

<style>
  .hero-video {
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .hero-video video {
    filter: saturate(0.4) contrast(1.05);
  }
  .hero-photo {
    transition: opacity 0.7s ease;
  }
  #top.is-video .hero-video {
    opacity: 1;
  }
  /* Primero entra el video por detrás; la foto se retira después (sin bajón de brillo) */
  #top.is-video .hero-photo {
    opacity: 0;
    transition-delay: 0.4s;
  }
  /* La foto se desvanece a transparente por los bordes y deja ver el humo de fondo */
  .hero-photo {
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 52%, transparent 96%);
    mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 52%, transparent 96%);
  }
  @media (min-width: 768px) {
    .hero-photo {
      -webkit-mask-image:
        linear-gradient(to right, transparent, #000 18%, #000 82%, transparent),
        linear-gradient(to bottom, transparent, #000 14%, #000 52%, transparent 96%);
      mask-image:
        linear-gradient(to right, transparent, #000 18%, #000 82%, transparent),
        linear-gradient(to bottom, transparent, #000 14%, #000 52%, transparent 96%);
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
    }
  }
  .hero-kenburns {
    animation: kenburns 24s ease-in-out infinite alternate;
    transform-origin: 50% 30%;
  }
  .hero-content {
    animation: rise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes kenburns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.07);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-kenburns,
    .hero-content {
      animation: none;
    }
  }
</style>

<script>
  // Primero la foto; cuando el video ya corre (y pasaron al menos 2.5 s), fundido al video.
  const section = document.getElementById("top");
  const video = section?.querySelector<HTMLVideoElement>(".hero-video video");
  const source = video?.querySelector("source");
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (section && video && source && !saveData && !reduceMotion) {
    const MIN_PHOTO_MS = 2500;
    const t0 = performance.now();

    const start = () => {
      source.src = source.dataset.src ?? "";
      video.load();
      video.addEventListener(
        "playing",
        () => {
          const wait = Math.max(0, MIN_PHOTO_MS - (performance.now() - t0));
          setTimeout(() => section.classList.add("is-video"), wait);
        },
        { once: true }
      );
      video.play().catch(() => {});
    };

    // El video (3 MB) se baja después de que cargó todo lo demás.
    if (document.readyState === "complete") start();
    else window.addEventListener("load", start, { once: true });
  }
</script>
