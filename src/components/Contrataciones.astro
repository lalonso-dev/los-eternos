---
import Icon from "./Icon.astro";
import SectionHeader from "./SectionHeader.astro";
import { contacts, whatsappHref, telHref } from "../data/contacts";
---

<section id="contrataciones" class="band scroll-mt-24 px-6 py-24 text-center md:px-20 md:py-36">
  <SectionHeader
    eyebrow="Eventos Privados"
    title="Contrataciones"
    subtitle="Contrata a Los Eternos para tu boda, fiesta o evento. Escríbenos y coticemos juntos los detalles"
  />
  <div class="mx-auto flex max-w-3xl flex-wrap justify-center gap-12">
    {contacts.map((contact) => (
      <div class="flex flex-1 flex-col items-center gap-5" style="flex-basis: 260px; max-width: 320px;">
        <div class="text-[13px] font-bold uppercase tracking-[0.2em] text-dorado">
          Atendido por {contact.name}
        </div>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={whatsappHref(contact)}
            target="_blank"
            rel="noreferrer"
            class="card flex w-[130px] flex-col items-center gap-3 px-3 py-7"
            style="--brand: #25D366"
          >
            <span class="icon-ring h-11 w-11">
              <Icon name="whatsapp" class="h-5 w-5" />
            </span>
            <span class="text-[12px] font-bold uppercase tracking-[0.14em] text-cream">WhatsApp</span>
          </a>
          <a
            href={telHref(contact)}
            class="card flex w-[130px] flex-col items-center gap-3 px-3 py-7"
            style="--brand: var(--color-dorado); --brand-ink: var(--color-negro)"
          >
            <span class="icon-ring h-11 w-11">
              <Icon name="phone" class="h-5 w-5" />
            </span>
            <span class="text-[12px] font-bold uppercase tracking-[0.14em] text-cream">Llamar</span>
          </a>
        </div>
      </div>
    ))}
  </div>
</section>
