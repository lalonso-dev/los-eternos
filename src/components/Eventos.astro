---
import SectionHeader from "./SectionHeader.astro";
---

<section id="eventos" class="band scroll-mt-24 px-6 py-24 text-center md:px-20 md:py-36">
  <SectionHeader eyebrow="Agenda" title="Próximos Eventos" class="mb-12" />

  <!-- Carrusel: se desliza con el dedo; en escritorio también con las flechas -->
  <div id="eventos-carrusel" class="relative hidden">
    <div class="mx-auto max-w-[1100px]">
      <ul id="eventos-lista" class="text-left" aria-label="Próximos eventos"></ul>
    </div>
    <div class="mt-4 flex items-center justify-center gap-5">
      <button
        type="button"
        id="eventos-prev"
        aria-label="Evento anterior"
        class="hidden h-10 w-10 items-center justify-center rounded-full border border-dorado/50 text-lg text-dorado transition hover:bg-dorado hover:text-negro disabled:pointer-events-none disabled:opacity-30 md:flex"
      >
        ‹
      </button>
      <div id="eventos-dots" class="flex justify-center gap-2" role="tablist" aria-label="Eventos"></div>
      <button
        type="button"
        id="eventos-next"
        aria-label="Evento siguiente"
        class="hidden h-10 w-10 items-center justify-center rounded-full border border-dorado/50 text-lg text-dorado transition hover:bg-dorado hover:text-negro disabled:pointer-events-none disabled:opacity-30 md:flex"
      >
        ›
      </button>
    </div>
  </div>

  <div id="eventos-vacio" class="card mx-auto max-w-xl px-6 py-10 md:px-12">
    <p class="mb-6 text-[17px] leading-relaxed text-body-text">
      Muy pronto anunciaremos nuestras próximas fechas. Síguenos en redes
      para no perderte ningún evento.
    </p>
    <a
      href="#redes"
      class="btn-gold"
    >
      Ver Redes Sociales
    </a>
  </div>
</section>

<script>
  import { supabase, formatFecha, COLUMNAS_PUBLICAS, type EventoPublico } from "../lib/supabase";
  import { initMuCarousel } from "../utils/muCarousel";

  const lista = document.getElementById("eventos-lista")!;
  const carrusel = document.getElementById("eventos-carrusel")!;
  const vacio = document.getElementById("eventos-vacio")!;

  // Publico: solo fecha, lugar y banner. Horarios, mapa y notas son solo para musicos.
  function card(e: EventoPublico) {
    const f = formatFecha(e.fecha);
    const li = document.createElement("li");
    li.className = "card overflow-hidden";

    if (e.banner_url) {
      const img = document.createElement("img");
      img.src = e.banner_url;
      img.alt = `Los Eternos en ${e.lugar}, ${f.larga}`;
      img.loading = "lazy";
      img.className = "block h-full w-full object-cover";
      img.draggable = false;
      li.append(img);
      return li;
    }

    const row = document.createElement("div");
    row.className = "flex h-full w-[var(--mu-l,20rem)] items-center gap-5 p-4 md:p-5";
    const fecha = document.createElement("div");
    fecha.className = "flex h-20 w-20 shrink-0 flex-col items-center justify-center rounded-md bg-gradient-to-b from-dorado-claro via-dorado to-dorado-oscuro text-negro";
    fecha.innerHTML = `<span class="text-3xl font-extrabold leading-none"></span><span class="text-xs font-bold tracking-widest"></span>`;
    fecha.children[0].textContent = f.dia;
    fecha.children[1].textContent = f.mes;
    const info = document.createElement("div");
    const lugar = document.createElement("div");
    lugar.className = "font-display text-xl font-bold text-cream";
    lugar.textContent = e.lugar;
    const detalle = document.createElement("div");
    detalle.className = "text-sm capitalize text-muted";
    detalle.textContent = f.larga;
    info.append(lugar, detalle);
    row.append(fecha, info);
    li.append(row);
    return li;
  }

  async function cargar() {
    const hoy = new Date().toLocaleDateString("en-CA");
    const { data, error } = await supabase
      .from("eventos")
      .select(COLUMNAS_PUBLICAS)
      .eq("publicado", true)
      .gte("fecha", hoy)
      .order("fecha", { ascending: true });

    // Ante cualquier error o sin eventos se queda el mensaje por defecto.
    if (error || !data?.length) return;
    lista.replaceChildren(...data.map(card));
    carrusel.classList.remove("hidden");
    vacio.classList.add("hidden");
    // Se inicia ya visible, para que midan bien las tarjetas.
    initMuCarousel(lista, {
      ratio: 1,
      dots: document.getElementById("eventos-dots"),
      prev: document.getElementById("eventos-prev") as HTMLButtonElement,
      next: document.getElementById("eventos-next") as HTMLButtonElement,
    });
  }

  cargar();
</script>
